/_app/immutable/*.js
  Content-Type: application/javascript
  Cache-Control: public, max-age=31536000, immutable
/_app/immutable/*.css
  Content-Type: text/css
  Cache-Control: public, max-age=31536000, immutable
/_app/immutable/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
